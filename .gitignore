# --- Pipeline outputs (regenerable, often large) -----------------------------
results/

# --- Input data (FASTQs, references, Bismark indexes) ------------------------
# Real sequencing data should never be tracked in git (too large, privacy).
# Synthetic data is regenerated by the make_*_fastqs.py scripts, so safe to
# exclude. The generators themselves live in scripts/ and ARE tracked.
data/

# --- Python caches and build artifacts ---------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.coverage
.coverage.*
.tox/

# --- Demo plots produced by run_example.py -----------------------------------
examples/

# --- Editor and OS junk ------------------------------------------------------
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# --- samtools / bowtie2 / Bismark side files ---------------------------------
*.fai
*.bai

# --- Conda / venv ------------------------------------------------------------
.venv/
venv/
env/
